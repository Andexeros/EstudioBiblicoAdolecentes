# Variables privadas del servidor. En producción, cargarlas directamente en Vercel.
# Este archivo es una plantilla: no incluir contraseñas ni claves reales en GitHub.
NEON_AUTH_BASE_URL=https://ep-proud-poetry-b4jb0n37.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# Generar un secreto aleatorio de 32 bytes y pegarlo en la siguiente variable.
NEON_AUTH_COOKIE_SECRET=
# Copiar la conexión PostgreSQL con pooling desde Neon → Connect.
DATABASE_URL=
HUELLAS_SITE_URL=https://estudiobiblicoadolecentes.vercel.app
# Correo de tu cuenta administradora; varios correos se separan con comas.
HUELLAS_ADMIN_EMAILS=
HUELLAS_GOOGLE_ENABLED=false

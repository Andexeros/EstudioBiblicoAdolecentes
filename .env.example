# Variables privadas del servidor. En producción, cargarlas directamente en Vercel.
# Este archivo es una plantilla: no incluir contraseñas ni claves reales en GitHub.
NEON_AUTH_BASE_URL=https://ep-proud-poetry-b4jb0n37.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# Generar un secreto aleatorio de 32 bytes y pegarlo en la siguiente variable.
NEON_AUTH_COOKIE_SECRET=
# Copiar la conexión PostgreSQL con pooling desde Neon → Connect.
DATABASE_URL=
HUELLAS_SITE_URL=https://estudiosbiblicossr.vercel.app
# Configuración heredada. Desde la migración de aprobaciones los permisos viven en Neon.
# No concede privilegios; el propietario asigna administradores desde el panel.
HUELLAS_ADMIN_EMAILS=
# Cambiar a true en Vercel después de configurar Google OAuth en Neon y aplicar el SQL de perfil.
# Client ID y Client Secret de Google se guardan en Neon, no en estas variables.
HUELLAS_GOOGLE_ENABLED=false

# Solo para eliminar identidades permanentemente desde el panel del propietario.
# Estas tres variables son privadas. Nunca usar prefijos públicos ni pegarlas en GitHub.
# Si quedan vacías, aprobación, bloqueo, grupos, roles y auditoría funcionan igualmente.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

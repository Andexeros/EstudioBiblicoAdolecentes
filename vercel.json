{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --omit=peer",
  "outputDirectory": "dist",
  "functions": { "api/**/*.js": { "maxDuration": 20 } },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }, { "key": "Referrer-Policy", "value": "no-referrer" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }] }
  ]
}
